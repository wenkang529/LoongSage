+    async def _update_lora_adapter_from_channel(
+        self: TokenizerManager,
+        obj: UpdateWeightsFromChannelReqInput,
+    ) -> Tuple[bool, str]:
+        """Swap adapter `obj.lora_name` for the channel tensors under a fresh lora_id (no upsert).
+
+        Holds model_update_lock.writer_lock (drains in-flight generates) then
+        lora_update_lock, the same order generate() uses.
+        """
+        if obj.weight_version == "":
+            return False, "weight_version must not be empty"
+        if not get_lora().enable_lora:
+            return False, "LoRA adapter sync requires the server to run with --enable-lora."
+        if not obj.lora_name or not obj.lora_config_dict:
+            return False, "LoRA adapter sync requires lora_name and lora_config_dict."
+        if not (get_parallel().dp_size == 1 or get_parallel().enable_dp_attention):
+            return False, "LoRA adapter sync requires dp_size == 1 or dp attention."
+
+        async with self.model_update_lock.writer_lock:
+            async with self.lora_update_lock:
+                if obj.lora_name in self.pending_lora_unloads:
+                    return False, (
+                        f"LoRA adapter '{obj.lora_name}' has an incomplete unload. "
+                        "Retry the unload before syncing it again."
+                    )
+
+                old_ref = self.lora_registry.get_all_adapters().get(obj.lora_name)
+                if old_ref is not None:
+                    await self.lora_registry.unregister(obj.lora_name)
+                    await self.lora_registry.wait_for_unload(old_ref.lora_id)
+
+                new_ref = LoRARef(
+                    lora_name=obj.lora_name,
+                    lora_path="__tensor__",
+                    pinned=obj.lora_pinned,
+                )
+                obj.lora_id = new_ref.lora_id
+                results = await self.update_weights_from_channel_communicator(obj)
+                success, message = FanOutCommunicator.merge_results(results)
+                if success:
+                    await self.lora_registry.register(new_ref)
+                    self.lora_ref_cache[obj.lora_name] = new_ref
+                    self._update_weight_version_if_provided(obj.weight_version)
+                    message += f" Weight version updated to {obj.weight_version}."
+                else:
+                    # "__tensor__" adapters can't reload from disk: keep the name unregistered.
+                    self.lora_ref_cache.pop(obj.lora_name, None)
+                logger.info(
+                    "LoRA adapter sync from channel: name=%s lora_id=%s success=%s",
+                    obj.lora_name,
+                    new_ref.lora_id,
+                    success,
+                )
+                return success, message
+
