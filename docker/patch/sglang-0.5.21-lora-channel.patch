+    def _load_lora_adapter_from_channel(self: WeightUpdater, recv_req, channel):
+        """Replace adapter `recv_req.lora_name` with the channel tensors.
+
+        Drains the channel first: the receive is collective and must complete on every rank.
+        """
+        tensors = {name: t.to("cpu") for name, t in channel.get_iterator()}
+        lora_manager = self.get_model_runner().lora_manager
+        if lora_manager is None:
+            return False, "LoRA adapter sync requires --enable-lora."
+
+        name = recv_req.lora_name
+        for old_ref in [r for r in lora_manager.lora_refs.values() if r.lora_name == name]:
+            result = lora_manager.unload_lora_adapter(old_ref)
+            if not result.success:
+                return False, (
+                    f"Failed to unload previous LoRA adapter '{name}' "
+                    f"({old_ref.lora_id}): {result.error_message}"
+                )
+
+        new_ref = recv_req.to_lora_ref()
+        result = lora_manager.load_lora_adapter_from_tensors(
+            new_ref, tensors, recv_req.lora_config_dict
+        )
+        if not result.success:
+            lora_manager.unload_lora_adapter(new_ref)
+            return False, (
+                f"Failed to load LoRA adapter '{name}' from channel: "
+                f"{result.error_message}"
+            )
+        return True, (
+            f"Succeeded to load LoRA adapter '{name}' ({len(tensors)} tensors) "
+            "from channel."
+        )
+
 
